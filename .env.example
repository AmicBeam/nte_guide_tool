NTE_ENV=production
NTE_SECRET_KEY=replace-with-your-secret-key
NTE_DATABASE_PATH=C:\path\to\nte_board_game.db
NTE_TOKEN_TTL_HOURS=72
NTE_DEFAULT_MAP_ID=rob_bank
NTE_LOG_DIR=C:\path\to\logs
NTE_MOVE_STEP_LIMIT=64
NTE_DRAW_LOOP_LIMIT=64

# Wiki floating assistant: OpenAI-compatible, vision-capable model with tool calls.
NTE_GUIDE_CHAT_BASE_URL=https://your-model-provider.example/v1
NTE_GUIDE_CHAT_API_KEY=replace-with-model-api-key
NTE_GUIDE_CHAT_MODEL=doubao-seed-2-1-pro-260915
NTE_GUIDE_CHAT_TIMEOUT=90
NTE_GUIDE_CHAT_MAX_TOKENS=4096
# Optional trusted CA bundle when the Python runtime lacks system roots.
# NTE_GUIDE_CHAT_CA_BUNDLE=/path/to/trusted-ca-bundle.pem
